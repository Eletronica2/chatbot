# Copie para .env (chmod 600). Nunca versionar o .env.
QDRANT_API_KEY=troque-por-um-segredo-aleatorio

LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
ALLOWED_MODELS=qwen3:4b-instruct-2507-q4_K_M,qwen3:1.7b-q4_K_M
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=192
LLM_KEEP_ALIVE=30m
OLLAMA_KEEP_ALIVE=30m
LLM_CONCURRENCY=1
LLM_MAX_QUEUE=3
LLM_QUEUE_TIMEOUT_S=90

EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_DIM=768
EMBEDDING_THREADS=4

RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=3

# 0 apenas durante o bootstrap (download dos modelos de embedding)
HF_HUB_OFFLINE=1
LOG_LEVEL=INFO

+String? _whatsAppDigits(String? raw) {
+  var digits = (raw ?? '').replaceAll(RegExp(r'\D'), '');
+  if (digits.isEmpty) return null;
+  if (digits.length == 10 || digits.length == 11) digits = '55$digits';
+  return digits.length >= 12 ? digits : null;
+}

# Security
APP_SECRET_KEY=change-me-backend-secret
JWT_EXPIRES_MINUTES=720
INTERNAL_API_KEY=internal-chatbot-key
ADMIN_PANEL_URL=http://localhost:8000
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@chatbot.local
SMTP_FROM_NAME=Chatbot SaaS
SMTP_USE_TLS=true
SMTP_USE_SSL=false
BILLING_PROVIDER=stripe
BILLING_GRACE_DAYS=3
BILLING_SUCCESS_URL=http://localhost:8000/#/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:8000/#/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:8000/#/billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_ON_DEMAND_PRICE_ID=
STRIPE_METER_EVENT_NAME=
STRIPE_DEFAULT_CURRENCY=brl

# Fiscal stub — never invent NF until a real provider is ready
FISCAL_PROVIDER=none
FISCAL_PROVIDER_READY=false

# Gateway
GATEWAY_API_URL=http://whatsapp-gateway:40000
GATEWAY_API_TIMEOUT=15

CORS_ORIGINS=*
TRUST_PROXY=false

# Meta / WhatsApp Tech Provider — never commit real secrets
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_EMBEDDED_CONFIG_ID=
META_API_VERSION=v22.0
META_API_BASE_URL=https://graph.facebook.com
META_API_TIMEOUT=30
META_VERIFY_TOKEN=change-me-webhook-verify-token
META_DATA_DELETION_BASE_URL=https://api.APP_DOMAIN/api/v1/meta/data-deletion/status
META_TEST_RECIPIENT=


# Application
APP_NAME=Backend API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Integrations
FLOW_ENGINE_URL=http://flow-engine:8002
FLOW_ENGINE_TIMEOUT=15
AI_ENGINE_URL=http://ai-engine:8003
AI_ENGINE_TIMEOUT=20
DATABASE_URL=mysql+pymysql://chatbot:chatbot@mysql:3306/chatbot

# Sessions and tenant defaults
SESSION_TTL_SECONDS=3600
DEFAULT_TENANT_ID=default
DEFAULT_TENANT_NAME=Tenant Demo
DEFAULT_TENANT_EMAIL=demo@chatbot.local

# Admin bootstrap
DEFAULT_ADMIN_EMAIL=admin@demo.local
DEFAULT_ADMIN_PASSWORD=admin1234
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_ROLE=superadmin

# Security
APP_SECRET_KEY=change-me-backend-secret
JWT_EXPIRES_MINUTES=720
INTERNAL_API_KEY=internal-chatbot-key
ADMIN_PANEL_URL=http://localhost:8000
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@chatbot.local
SMTP_FROM_NAME=Chatbot SaaS
SMTP_USE_TLS=true
SMTP_USE_SSL=false
BILLING_PROVIDER=stripe
BILLING_GRACE_DAYS=3
BILLING_SUCCESS_URL=http://localhost:8000/#/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:8000/#/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:8000/#/billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_DEFAULT_CURRENCY=brl

# Gateway
GATEWAY_API_URL=http://whatsapp-gateway:40000
GATEWAY_API_TIMEOUT=15

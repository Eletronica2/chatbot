FLOW_ENGINE_TIMEOUT=15
AI_ENGINE_URL=http://ai-engine:8003
AI_ENGINE_TIMEOUT=20
DATABASE_URL=mysql+pymysql://chatbot:chatbot@mysql:3306/chatbot

# Sessions and tenant defaults
SESSION_TTL_SECONDS=3600
DEFAULT_TENANT_ID=default
DEFAULT_TENANT_NAME=Operacao SaaS
DEFAULT_TENANT_EMAIL=operacao@chatbot.local

# Admin bootstrap
DEFAULT_ADMIN_EMAIL=arthurlaranjo@hotmail.com
